<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data>
        <template id="add_contact_my_details">
            <t t-call="website.layout">
                <t t-set="no_footer" t-value="1"/>
                <t t-set="additional_title">Selection of Contact</t>
                <form t-attf-action="/my/#{address_type if address_type else partner.type}/submit" method="post">
                    <div class="wrap">
                        <div class="container py-2">
                            <div class="row">
                                <div class="col-12">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <div class="row my-2" id="form_group_1">
                                        <div t-attf-class="form-group col-6">
                                            <label class="col-form-label" for="name">Contact Name</label>
                                            <input type="text" name="name" t-attf-class="form-control" t-att-placeholder="partner.name" />
                                        </div>
                                        <div t-attf-class="form-group col-6" id="address_type_field">
                                            <label class="col-form-label" for="type">Address Type</label>
                                            <select name="type" t-attf-class="form-control" readonly="1">
                                                <t t-foreach="types" t-as="type">
                                                    <option t-att-value="type[0]" t-att-selected="type[0] == address_type">
                                                        <t t-esc="type[1]"/>
                                                    </option>
                                                </t>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="row my-2">
                                        <div t-attf-class="form-group col-4">
                                            <label class="col-form-label" for="email">Email</label>
                                            <input type="tel" name="email" t-attf-class="form-control" t-att-placeholder="partner.email" />

                                            <label class="col-form-label" for="street">Street <span class="d-none d-md-inline"> and Number</span></label>
                                            <input type="text" name="street" t-attf-class="form-control" t-att-placeholder="partner.street"/>

                                            <label class="col-form-label" for="country_id">Country</label>
                                            <select id="country_id" name="country_id" t-attf-class="form-control">
                                                <t t-foreach="countries" t-as="c">
                                                    <option t-att-value="c.id" t-att-selected="c.id == partner.country_id.id">
                                                        <t t-esc="c.name"/>
                                                    </option>
                                                </t>
                                            </select>
                                        </div>

                                        <div t-attf-class="form-group col-4">
                                            <label class="col-form-label" for="mobile">Mobile</label>
                                            <input type="tel" name="mobile" t-attf-class="form-control" t-att-placeholder="partner.mobile"/>

                                            <label class="col-form-label" for="city">City</label>
                                            <input type="text" name="city" t-attf-class="form-control" t-att-placeholder="partner.city"/>

                                            <label class="col-form-label" for="state_id">State / Province</label>
                                            <select name="state_id" t-attf-class="form-control">
                                                <t t-foreach="states" t-as="s">
                                                    <option t-att-value="s.id" t-att-selected="s.id == partner.state_id.id">
                                                        <t t-esc="s.name" />
                                                    </option>
                                                </t>
                                            </select>
                                        </div>
                                        <div t-attf-class="form-group col-4">
                                            <label class="col-form-label" for="phone">Phone</label>
                                            <input type="tel" name="phone" t-attf-class="form-control" t-att-placeholder="partner.phone"/>

                                            <label class="col-form-label" for="zip">Zip Code</label>
                                            <input type="number" name="zip" t-attf-class="form-control" t-att-placeholder="partner.zip"/>
                                        </div>
                                    </div>
                                    <div class="row mt-3"><div t-attf-class="form-group col-6">
                                        <a href="/my/account" class="btn btn-primary float-start mb32">
                                            Cancel
                                            <span class="fa fa-long-arrow-left"/>
                                        </a></div><div t-attf-class="form-group col-6">
                                        <button type="submit" class="btn btn-primary float-end mb32">
                                            Submit
                                            <span class="fa fa-long-arrow-right" />
                                        </button></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </t>
        </template>
    </data>
</odoo>
