<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Portal -->
    <template id="portal_my_home_account_custom" name="Show My Account" customize_show="True" inherit_id="portal.portal_my_home" priority="60">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <t t-set="portal_client_category_enable" t-value="True"/>
        </xpath>
        <div id="portal_client_category" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/appointment/static/src/img/calendar.svg'"/>
                <t t-set="text">My Account, reschedule or cancel your appointments</t>
                <t t-set="title">My Account</t>
                <t t-set="url" t-value="'/my/account'"/>
            </t>
        </div>
    </template>

    <template id="portal_my_appointments_custom" name="My Appointments" inherit_id="appointment.portal_my_appointments">
        <xpath expr="//thead/tr/th" position="after">
            <th>Folio</th>
            <th>Quotation</th>        
            <th>Costo</th>
        </xpath>
        
        <xpath expr="//tbody/t/tr/td" position="after">
            <td><span> <t t-out="appointment.folio"/></span></td>
            <td><a t-att-href="appointment.sale_id.get_portal_url()"><t t-out="appointment.sale_id.name" /></a></td>
            <td><span> <t t-out="appointment.stn_precio_total" t-options='{"widget": "monetary", "display_currency": appointment.sale_id.currency_id}'/></span></td>
        </xpath>
        <xpath expr="//a" position="replace">
                <a t-attf-href="/calendar/view/#{appointment.access_token}?partner_id=#{request.env.user.partner_id.id}">
                    <span t-out="request.env.user.partner_id.name" /> 
                </a>
        </xpath>
    </template>

    <template id="appointment_validated_website_custom" name="Website Appointment: Appointment Confirmed" inherit_id="website_appointment.appointment_validated">
        <xpath expr="//nav" position="replace">
            <nav />
        </xpath>
    </template>
    <template id="appointment_validated_custom" name="Website Appointment: Appointment Confirmed" inherit_id="appointment.appointment_validated">
        <xpath expr="//div[@class='o_appointment_validation_details row justify-content-between']/div/div[1]" position="replace">
            <div class="row" />
        </xpath>
        <xpath expr="//div[@class='o_appointment_validation_details row justify-content-between']/div/div[2]" position="replace">
            <div class="row" />
        </xpath>
        <xpath expr="//div[@t-if='based_on_users or appointment_type.location_id or event.location']" position="replace">
            <div t-if="based_on_users or appointment_type.location_id or event.location" class="row" />
        </xpath>
        <xpath expr="//div[@t-if='based_on_users or appointment_type.allow_guests']" position="replace">
            <div t-if="based_on_users or appointment_type.allow_guests" class="row" />
        </xpath>
        <xpath expr="//div[@class='o_appointment_validation_details row justify-content-between']/div" position="inside">
            <div class="row mb-4">
                <div class="col-3">
                    <label class="text-muted">Reservation</label>
                </div>
                <div class="col-9 col-lg-6">
                    <span>
                        <div class="fw-bold" t-field="appointment_type.name" />
                    </span>
                    <div>
                        <div class="d-flex py-1 px-0 bg-transparent o-cc1-text border-0">
                            <i class="fa fa-caret-right fa-fw me-2 mt-1 text-muted"/>
                            <span t-if="event.stn_no_personas">Folio: <t t-out="event.folio"/> </span>
                        </div>
                        <div class="d-flex py-1 px-0 bg-transparent o-cc1-text border-0">
                            <i class="fa fa-caret-right fa-fw me-2 mt-1 text-muted"/>
                            <span t-if="event.sale_id">Quotation: <a t-att-href="event.sale_id.get_portal_url()"><t t-out="event.sale_id.name" /></a></span>
                        </div>
                        <div class="d-flex py-1 px-0 bg-transparent o-cc1-text border-0">
                            <i class="fa fa-users fa-fw me-2 mt-1 text-muted"/>
                            <span t-if="event.stn_no_personas">Number of Guests: <t t-out="event.stn_no_personas"/> </span>
                        </div>
                        <div class="d-flex py-1 px-0 bg-transparent o-cc1-text border-0" t-if="event.stn_no_habitaciones > 0.0">
                            <i class="fa fa-users fa-fw me-2 mt-1 text-muted"/>
                            <span t-if="event.stn_no_habitaciones">Number of Rooms: <t t-out="event.stn_no_habitaciones"/> </span>
                        </div>
                        <div class="d-flex py-1 px-0 bg-transparent o-cc1-text border-0" t-if="event.stn_no_guias > 0.0">
                            <i class="fa fa-users fa-fw me-2 mt-1 text-muted"/>
                            <span t-if="event.stn_no_guias">Number of Guides: <t t-out="event.stn_no_guias"/> </span>
                            <span t-out="event.stn_no_guias" />
                        </div>
                    </div>
                </div>
            </div>
            <div class="row mt-4">
                <div class="col-3">
                    <label class="text-muted">Additional Fees</label>
                </div>
                <div class="col-9 col-lg-6">
                    <div>
                        <t t-set="extra_ids" t-value="appointment_type.additional_fees_ids.mapped('product_id')" />
                        <t t-set="line_extra_ids" t-value="event.sale_id.order_line.filtered(lambda l: l.product_id in extra_ids) " />
                        <t t-foreach="line_extra_ids" t-as="line_extra">
                            <div class="d-flex py-1 px-0 bg-transparent o-cc1-text border-0">
                                <i class="fa fa-caret-right fa-fw me-2 mt-1 text-muted"/>
                                <span><t t-out="line_extra.name"/> <t t-out="line_extra.price_total" t-options='{"widget": "monetary", "display_currency": event.sale_id.currency_id}'/> </span>
                            </div>
                        </t>
                    </div>
                </div>
            </div>
            <div class="row mt-4">
                <div class="col-3">
                    <label class="text-muted">Total Rates</label>
                </div>
                <div class="col-9 col-lg-6">
                    <span>
                        <div class="fw-bold" ><span class="fw-bold" t-out="event.stn_precio_total" t-options='{"widget": "monetary", "display_currency": event.sale_id.currency_id}'  /> </div> 
                    </span>
                </div>
            </div>
            <div class="row mb-4 border-bottom">
                <br />
            </div>
            <div class="row mb-4">
                <div class="col-12">
                    <label class="fw-bold">Quotations</label>
                </div>
                <div class="col-12 col-lg-12">
                    <t t-set="stn_sale_id" t-value="event.sale_id" />
                    <t t-if="stn_sale_id">
                        <div class="row">
                           <div class="col-12">
                                <table class="table table-striped table-sm">
                                    <thead class="">
                                        <tr>
                                            <th scope="col"><strong>#</strong></th>
                                            <th><strong>Package</strong></th>
                                            <th><strong>Quantity</strong></th>
                                            <th><strong>Guides</strong></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                    <t t-foreach="stn_sale_id.order_line" t-as="sol">
                                        <t t-if="sol.display_type == 'line_section' ">
                                            <tr class="bg-secondary text-white">
                                                <td colspan="4"><strong class="text-uppercase font-bold" t-out="sol.name" /></td>
                                            </tr>
                                            <t t-set="indx_line" t-value="1"/>
                                        </t>
                                        <t t-if="sol.display_type != 'line_section' ">
                                            <tr class="bg-light">
                                                <td scope="row">
                                                    <span class="" t-out="indx_line" />
                                                </td>
                                                <td>
                                                    <span t-esc="sol.name" />
                                                </td>
                                                <td><span t-esc="sol.product_uom_qty" /></td>
                                                <td><span t-esc="sol.get_anglers_guides()" /></td>
                                            </tr>
                                            <t t-set="angler_id" t-value="sol.get_anglers()" />
                                            <tr t-if="angler_id">
                                                <td colspan="4">
                                                    <div class="row">
                                                        <div class="col-12">
                                                            <t t-if="angler_id.guest_ids">
                                                                <div class="row">
                                                                    <div class="col-12">
                                                                        <strong>Guests</strong>
                                                                    </div>
                                                                    <div class="col-12">
                                                                        <t t-foreach="angler_id.guest_ids" t-as="guest">
                                                                            <span class="" t-out="guest.name" /><br />
                                                                        </t>
                                                                    </div>
                                                                </div>
                                                            </t>
                                                        </div>
                                                    </div>
                                                </td>
                                            </tr>
                                            <t t-set="indx_line" t-value=" indx_line + 1"/>
                                        </t>
                                    </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </t>
                </div>
            </div>
        </xpath>
    </template>

    <template id="appointment_validated_card" name="Appointment Validated: User / Resource Card" inherit_id="appointment.appointment_validated_card">
        <xpath expr="//div[@t-if='staff_user and based_on_users']/article" position="replace">
            <article class="" />
        </xpath>
        <xpath expr="//div[@t-if='staff_user and based_on_users']" position="inside">
            <t t-set="recurso" t-value="event.sale_id.recurso_id" />
            <article class="card o_appointment_user_short_card card" itemscope="itemscope" itemtype="http://schema.org/Employee">
                <header t-if="event.sale_id" class="bg-secondary rounded-top o_appointment_avatar_container ratio ratio-4x3">
                    <div t-attf-style="background-image: url('/web/image/sale.resources/#{recurso.id}/image_1920');"
                            class="o_appointment_avatar_background"/>
                </header>
                <main class="card-body">
                    <h5 t-out="event.name"/>
                    <div class="o_appointment_card_user_fct mb-2 text-muted">
                        <div t-field="recurso.name" placeholder="Add a function here..."/>
                    </div>
                    <div class="list-group-flush">
                        <div t-if="event.start" class="list-group-item d-flex align-items-center">
                            <i class="fa fa-calendar fa-fw me-2 text-muted"/>
                            <span class="text-truncate"><t t-out="event.start.date()"/> - <t t-out="event.stop.date()"/></span>
                        </div>
                        <div t-if="event.stn_no_guias" class="list-group-item d-flex align-items-center">
                            <i class="fa fa-users fa-fw me-2 text-muted"/>
                            <span class="text-truncate">Guides: <t t-out="event.stn_no_guias"/></span>
                        </div>
                        <div t-if="event.stn_no_habitaciones" class="list-group-item d-flex align-items-center">
                            <i class="fa fa-users fa-fw me-2 text-muted"/>
                            <span class="text-truncate">Rooms: <t t-out="event.stn_no_habitaciones"/></span>
                        </div>
                    </div>
                </main>
            </article>
        </xpath>
    </template>

</odoo>

