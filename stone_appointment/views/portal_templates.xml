            <div t-if="search_datetime"  class="ms-lg-2">
                <form method="get" t-att-action="request.httprequest.path" class="d-inline">
                    <div class="btn-group">
                        <div class="input-group date">
                            <input type="text" name="datetime_filter" 
                                   class="form-control form-control-sm datetimepicker-input oe_datepicker_root" 
                                   data-widget="datetime-picker" 
                                   data-widget-type="datetime" 
                                   t-att-value="datetime_filter or ''" 
                                   placeholder="Selecciona fecha y hora" 
                                   dateFormat='yyyy-MM-dd HH:mm:ss'
                                   t-attf-style="max-width: 200px;" onchange="this.form.submit()"/>
                            <div class="input-group-append">
                                <span class="input-group-text"><i class="fa fa-calendar"/></span>
                            </div>
                        </div>
                        <input type="hidden" t-foreach="request.httprequest.args" t-as="key" t-att-name="key" t-att-value="request.httprequest.args[key]"/>
                    </div>
                </form>
            </div>


        </xpath>

        <!-- Script inline al final del nav -->
        <xpath expr="//nav" position="inside">
            <script type="text/javascript">

            </script>
        </xpath>

    </template>
</odoo>

